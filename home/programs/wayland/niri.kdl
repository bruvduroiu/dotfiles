// Niri owns the layout and keybinds; Noctalia owns the runtime palette.
// The optional include is created by Noctalia's built-in Niri template.
// Niri can start before the shell has generated it on first login.
include optional=true "noctalia.kdl"

// ----- input ----------------------------------------------------------
input {
    keyboard {
        // Must match fcitx expectations (see system/core) — fcitx can't
        // push layouts into the compositor.
        xkb {
            layout "us"
        }
    }
    touchpad {
        tap
        natural-scroll
        dwt
        // Hyprland carried a hand-rolled libinput custom accel curve;
        // niri only offers adaptive/flat + accel-speed. Tune to taste.
        accel-profile "adaptive"
    }
    // hover-focus without the view yanking sideways at screen edges
    focus-follows-mouse max-scroll-amount="0%"
    // Makes focus-workspace on the current workspace bounce back —
    // Mod+M / Mod+B become toggles like Hyprland's special workspaces,
    // and Mod+1 twice returns where you came from.
    workspace-auto-back-and-forth
}

// ----- outputs (framework13) ------------------------------------------
// Matched by "make model serial" (straight out of `niri msg outputs`),
// NOT by connector: the Asus comes up as DP-3 or DP-4 depending on which
// port it's plugged into, and niri silently ignores an output block whose
// name doesn't match — taking mode, scale, position AND the workspace
// pins below down with it. Connector names stay for the built-in panel,
// which is always eDP-1.
//
// Positions are LOGICAL px: the Asus is 3840 wide at scale 1, so eDP-1
// starts at x=3840 (matches the old Hyprland 3840x0).
//
// "Primary" is not a niri concept — it is these two properties: this
// output takes focus at startup, and workspaces 1-3 pin to it (below).
// Undocked, both degrade to eDP-1 on their own: an `open-on-output`
// naming an absent output is ignored, and `focus-at-startup` entries are
// tried in config order, so eDP-1's copy only ever applies when the Asus
// isn't there.
output "ASUSTek COMPUTER INC ASUS VG289 0x000024DB" {
    mode "3840x2160"
    scale 1
    position x=0 y=0
    // no variable-refresh-rate: this panel reports vrr_supported=false
    focus-at-startup
}
output "eDP-1" {
    scale 1.3333
    position x=3840 y=0
    variable-refresh-rate on-demand=true
    // Second in config order = laptop-only fallback for startup focus.
    focus-at-startup
}

// ----- layout ---------------------------------------------------------
layout {
    gaps 16
    center-focused-column "on-overflow"
    always-center-single-column

    // The old scrolling-layout explicit_column_widths, now first-class:
    // Mod+R / Mod+Shift+R cycle these.
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }
    default-column-width { proportion 0.5; }

    // 1px border on every window (colours from Noctalia) — tried the
    // niri focus ring, preferred the Hyprland-style border on all windows.
    focus-ring {
        off
    }
    border {
        width 1
    }

    // Tabbed columns replace Hyprland groups; the indicator is the strip
    // that replaces the groupbar (no text titles in niri).
    tab-indicator {
        hide-when-single-tab
        place-within-column
        position "top"
        gap 2
        width 3
    }

    struts {
        left 16
        right 16
        top 16
        bottom 16
    }
}

// ----- named workspaces -----------------------------------------------
// The five daily workspaces are all named — niri's native way to get a
// static, predictable strip (declaration order = strip order). Mod+1..5
// jump by name via niri-ws; Mod+6..9 count unnamed overflow workspaces.
// Output pins mirror the old Hyprland layout: 1-3 external, 4-5 laptop
// panel. Undocked, the external pins name an output that is not there,
// so those workspaces open on eDP-1; since niri 25.02 named workspaces
// stick to their configured output and go back to it on re-dock.
workspace "web" {
    open-on-output "ASUSTek COMPUTER INC ASUS VG289 0x000024DB"
}
workspace "code" {
    open-on-output "ASUSTek COMPUTER INC ASUS VG289 0x000024DB"
}
workspace "aux" {
    open-on-output "ASUSTek COMPUTER INC ASUS VG289 0x000024DB"
}
workspace "chat" {
    open-on-output "eDP-1"
    layout {
        struts {
            left 64
            right 64
            top 64
            bottom 64
        }
    }
}
workspace "work" {
    open-on-output "eDP-1"
    layout {
        struts {
            left 64
            right 64
            top 64
            bottom 64
        }
    }
}

// ----- misc -----------------------------------------------------------
prefer-no-csd
screenshot-path "~/Pictures/Screenshots/%Y-%m-%d_%H-%M-%S.png"

cursor {
    // XCursor theme from home.pointerCursor (home/default.nix); the
    // hyprcursor variant is used by the portable Hyprland profiles.
    xcursor-theme "BreezeX-RosePine-Linux"
    xcursor-size 24
    hide-when-typing
}

// No animations — tried the full minimal set, then workspace-switch
// alone, settled on none.
animations {
    off
}

// Flat Rosé Pine overview, with Noctalia's separate backdrop disabled.
overview {
    backdrop-color "#26233a"
    workspace-shadow {
        off
    }
}

hotkey-overlay {
    // Mod+Slash shows it (replaces the hypr-binds-menu script).
    skip-at-startup
}

environment {
    XMODIFIERS "@im=fcitx"
}

// ----- autostart ------------------------------------------------------
// fcitx5 stays owned by the NixOS i18n XDG-autostart systemd unit —
// niri-session activates xdg-desktop-autostart.target, same as UWSM did.
// Noctalia is a systemd user unit and owns clipboard history and locking.
spawn-at-startup "firefox"
spawn-at-startup "obsidian"

// ----- keybinds -------------------------------------------------------
// Mouse move/resize (Mod+LMB / Mod+RMB drags) are built in.
binds {
    // compositor
    Mod+Ctrl+Alt+Q { quit; }
    Mod+Q { close-window; }
    Mod+Shift+Escape { spawn "noctalia" "msg" "session" "lock-and-suspend"; }
    Mod+Shift+Ctrl+Escape { spawn "noctalia" "msg" "session" "shutdown"; }
    Mod+Slash { show-hotkey-overlay; }
    // Escape hatch when a VM or remote-desktop app grabs all shortcuts;
    // allow-inhibiting=false so the grab itself can't swallow this bind.
    Mod+Ctrl+Escape allow-inhibiting=false hotkey-overlay-title="Un-grab keyboard shortcuts" { toggle-keyboard-shortcuts-inhibit; }
    Mod+O { toggle-overview; }

    // focus (vim), axis-aligned with niri's model: H/L walk columns,
    // J/K walk the vertical workspace strip. The -or-last/-or-first
    // variants wrap around (Hyprland's wrap_focus).
    Mod+H { focus-column-left-or-last; }
    Mod+L { focus-column-right-or-first; }
    Mod+K { focus-workspace-up; }
    Mod+J { focus-workspace-down; }
    Mod+D { spawn "niri-focus-urgent"; }
    // move, same axes: Shift+H/L move the column sideways, Shift+J/K
    // carry it to the workspace below/above. H/L overflow: pushing a
    // column past the edge of the workspace lands it on the adjacent
    // monitor, so the common "send this to the other screen" needs no
    // new chord (at the edge, plain move-column-left was a no-op).
    Mod+Shift+H { move-column-left-or-to-monitor-left; }
    Mod+Shift+L { move-column-right-or-to-monitor-right; }
    Mod+Shift+K { move-column-to-workspace-up; }
    Mod+Shift+J { move-column-to-workspace-down; }

    // within-column (stacked/tabbed windows): focus and reorder
    Mod+Ctrl+K { focus-window-up; }
    Mod+Ctrl+J { focus-window-down; }
    Mod+Ctrl+Shift+K { move-window-up; }
    Mod+Ctrl+Shift+J { move-window-down; }

    // column membership (was scrolling `move ±col`)
    Mod+Comma { consume-or-expel-window-left; }
    Mod+Period { consume-or-expel-window-right; }

    // column widths / fit (was colresize + fit)
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+C { maximize-column; }
    Mod+Shift+C { center-visible-columns; }
    Mod+Ctrl+C { expand-column-to-available-width; }

    // scrolling extras (were swapcol / promote / center)
    Mod+Shift+U { swap-window-left; }
    Mod+Shift+O { swap-window-right; }
    Mod+Ctrl+U { move-column-to-first; }
    Mod+Ctrl+O { center-column; }

    // fullscreen / floating / tabs (was fullscreen / float / groups)
    Mod+Shift+F { fullscreen-window; }
    Mod+F { toggle-window-floating; }
    Mod+Shift+Space { switch-focus-between-floating-and-tiling; }
    Mod+G { toggle-column-tabbed-display; }

    // utilities
    // +new-window goes through D-Bus to the resident systemd-managed
    // instance (~20ms) instead of cold-starting GTK per window (~300ms).
    Mod+Return { spawn "ghostty" "+new-window"; }
    Mod+Y { spawn "ghostty" "+new-window" "-e" "yazi"; }
    Mod+Space hotkey-overlay-title="Noctalia launcher" { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+Ctrl+Q allow-when-locked=true allow-inhibiting=false { spawn "noctalia" "msg" "session" "lock"; }
    Mod+Ctrl+V { spawn "noctalia" "msg" "panel-toggle" "clipboard"; }
    Mod+W { spawn "noctalia" "msg" "window-switcher"; }
    Mod+Ctrl+Period { spawn "noctalia" "msg" "panel-toggle" "launcher" "/emo "; }
    Mod+Shift+D { spawn "noctalia" "msg" "notification-dnd-toggle"; }
    Mod+Ctrl+D { spawn "noctalia" "msg" "panel-open" "control-center" "notifications"; }
    Mod+Ctrl+Space hotkey-overlay-title="Control center" { spawn "noctalia" "msg" "panel-toggle" "control-center"; }

    // launchers (was the Mod+X submap; niri has no submaps)
    // Noctalia: Mod+Ctrl opens panels; arrows/Alt+hjkl navigate inside them.
    Mod+Ctrl+A hotkey-overlay-title="Audio" { spawn "noctalia" "msg" "panel-open" "control-center" "audio"; }
    Mod+Ctrl+B hotkey-overlay-title="Bluetooth" { spawn "noctalia" "msg" "panel-open" "control-center" "bluetooth"; }
    Mod+Ctrl+N hotkey-overlay-title="Network" { spawn "noctalia" "msg" "panel-open" "control-center" "network"; }
    Mod+Ctrl+M hotkey-overlay-title="Media" { spawn "noctalia" "msg" "panel-open" "control-center" "media"; }
    Mod+Ctrl+P hotkey-overlay-title="Power" { spawn "noctalia" "msg" "panel-open" "control-center" "power"; }
    Mod+Ctrl+T hotkey-overlay-title="Calendar" { spawn "noctalia" "msg" "panel-open" "control-center" "calendar"; }
    Mod+Ctrl+W hotkey-overlay-title="Weather" { spawn "noctalia" "msg" "panel-open" "control-center" "weather"; }
    Mod+Ctrl+I hotkey-overlay-title="System monitor" { spawn "noctalia" "msg" "panel-open" "control-center" "system"; }
    Mod+Ctrl+F5 hotkey-overlay-title="Wallpaper picker" { spawn "noctalia" "msg" "panel-toggle" "wallpaper"; }
    Mod+Ctrl+Comma hotkey-overlay-title="Noctalia settings" { spawn "noctalia" "msg" "settings-toggle"; }
    Mod+Ctrl+Shift+Q hotkey-overlay-title="Session menu" { spawn "noctalia" "msg" "panel-toggle" "session"; }
    Mod+Ctrl+Shift+I hotkey-overlay-title="Toggle caffeine" { spawn "noctalia" "msg" "caffeine-toggle"; }
    Mod+Ctrl+Shift+D hotkey-overlay-title="Open latest notification" { spawn "noctalia" "msg" "notification-invoke-latest"; }
    Mod+Ctrl+Shift+BackSpace hotkey-overlay-title="Dismiss notification toasts" { spawn "noctalia" "msg" "notification-clear-active"; }

    Mod+Alt+A hotkey-overlay-title="OpenRouter chat" { spawn "firefox" "--new-tab" "https://openrouter.ai/chat"; }
    Mod+Alt+B hotkey-overlay-title="Browser" { spawn "firefox"; }
    Mod+Alt+W hotkey-overlay-title="Work browser" { spawn "firefox" "-P" "work" "--no-remote"; }
    Mod+Alt+H hotkey-overlay-title="Ghost browser" { spawn "mullvad-browser"; }
    Mod+Alt+O hotkey-overlay-title="Obsidian" { spawn "obsidian"; }
    Mod+Alt+R hotkey-overlay-title="Newsboat" { spawn "ghostty" "+new-window" "-e" "newsboat"; }
    Mod+Alt+Slash hotkey-overlay-title="KeePassXC" { spawn "keepassxc"; }

    // workspaces: dynamic per-monitor strip, indices are positions
    Mod+BracketLeft { focus-workspace-up; }
    Mod+BracketRight { focus-workspace-down; }
    Mod+Escape { focus-workspace-previous; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }

    // screencast target: share exactly one window in meetings (red ring
    // marks the window being cast; see the is-window-cast-target rule)
    Mod+S hotkey-overlay-title="Cast this window" { set-dynamic-cast-window; }
    Mod+Shift+S hotkey-overlay-title="Cast whole monitor" { set-dynamic-cast-monitor; }
    Mod+Ctrl+S hotkey-overlay-title="Stop dynamic cast" { clear-dynamic-cast-target; }

    // monitors — brackets are the monitor keys, and the modifier says
    // what travels: nothing / the column / the whole workspace. All
    // three-key, same pair, so there's one thing to remember.
    // For a tabbed column, swap move-column- for move-window- to peel
    // off just the focused window.
    Mod+Shift+BracketLeft  hotkey-overlay-title="Focus monitor left" { focus-monitor-left; }
    Mod+Shift+BracketRight hotkey-overlay-title="Focus monitor right" { focus-monitor-right; }
    Mod+Ctrl+BracketLeft   hotkey-overlay-title="Send window to monitor left" { move-column-to-monitor-left; }
    Mod+Ctrl+BracketRight  hotkey-overlay-title="Send window to monitor right" { move-column-to-monitor-right; }
    Mod+Alt+BracketLeft    hotkey-overlay-title="Send workspace to monitor left" { move-workspace-to-monitor-left; }
    Mod+Alt+BracketRight   hotkey-overlay-title="Send workspace to monitor right" { move-workspace-to-monitor-right; }

    // theme toggle
    Mod+F5 { spawn "noctalia" "msg" "theme-mode-toggle"; }

    // screenshot (grim + satty pipeline, unchanged)
    Print { spawn "screenshot" "full"; }
    Shift+Print { spawn "screenshot" "area"; }

    // screen recording
    Mod+Print { spawn "wf-recorder-toggle"; }
    Mod+Shift+Print { spawn "wf-recorder-toggle" "area"; }

    // locked / repeating media + brightness
    XF86AudioRaiseVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-down"; }
    XF86AudioMute allow-when-locked=true { spawn "noctalia" "msg" "volume-mute"; }
    XF86AudioMicMute allow-when-locked=true { spawn "noctalia" "msg" "mic-mute"; }
    // Laptop brightness keys always target its panel, even when a docked
    // external monitor without brightness control has keyboard focus.
    XF86MonBrightnessUp allow-when-locked=true { spawn "noctalia" "msg" "brightness-up" "eDP-1"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "noctalia" "msg" "brightness-down" "eDP-1"; }
    XF86AudioNext allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPause allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPlay allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPrev allow-when-locked=true { spawn "playerctl" "previous"; }

    // workspaces 1..9: switch / move / move-silent. Via niri-ws, not raw
    // indices: declared named workspaces (chat/work) always occupy the top
    // of the strip, so raw `focus-workspace 1` would land on "work".
    // niri-ws maps N to the Nth UNNAMED workspace on the focused output.
    Mod+1 { spawn "niri-ws" "focus" "1"; }
    Mod+2 { spawn "niri-ws" "focus" "2"; }
    Mod+3 { spawn "niri-ws" "focus" "3"; }
    Mod+4 { spawn "niri-ws" "focus" "4"; }
    Mod+5 { spawn "niri-ws" "focus" "5"; }
    Mod+6 { spawn "niri-ws" "focus" "6"; }
    Mod+7 { spawn "niri-ws" "focus" "7"; }
    Mod+8 { spawn "niri-ws" "focus" "8"; }
    Mod+9 { spawn "niri-ws" "focus" "9"; }
    Mod+Shift+1 { spawn "niri-ws" "move" "1"; }
    Mod+Shift+2 { spawn "niri-ws" "move" "2"; }
    Mod+Shift+3 { spawn "niri-ws" "move" "3"; }
    Mod+Shift+4 { spawn "niri-ws" "move" "4"; }
    Mod+Shift+5 { spawn "niri-ws" "move" "5"; }
    Mod+Shift+6 { spawn "niri-ws" "move" "6"; }
    Mod+Shift+7 { spawn "niri-ws" "move" "7"; }
    Mod+Shift+8 { spawn "niri-ws" "move" "8"; }
    Mod+Shift+9 { spawn "niri-ws" "move" "9"; }
    Mod+Ctrl+1 { spawn "niri-ws" "move-silent" "1"; }
    Mod+Ctrl+2 { spawn "niri-ws" "move-silent" "2"; }
    Mod+Ctrl+3 { spawn "niri-ws" "move-silent" "3"; }
    Mod+Ctrl+4 { spawn "niri-ws" "move-silent" "4"; }
    Mod+Ctrl+5 { spawn "niri-ws" "move-silent" "5"; }
    Mod+Ctrl+6 { spawn "niri-ws" "move-silent" "6"; }
    Mod+Ctrl+7 { spawn "niri-ws" "move-silent" "7"; }
    Mod+Ctrl+8 { spawn "niri-ws" "move-silent" "8"; }
    Mod+Ctrl+9 { spawn "niri-ws" "move-silent" "9"; }

    // Mod+Tab / Alt+Tab: left to the built-in recent-windows MRU switcher.
}

// ----- window rules ---------------------------------------------------
// Later rules override earlier ones per-property. Find app-ids with
// `niri msg pick-window`.

// scrolling column widths (were scrolling_width rules)
window-rule {
    match app-id=r#"(?i)^(firefox|org\.mozilla\.firefox|firefox-esr|firefox-bin|chromium|chromium-browser|google-chrome)"#
    default-column-width {
        proportion 0.66667
    }
}
window-rule {
    match app-id=r#"^com\.mitchellh\.ghostty$"#
    default-column-width {
        proportion 0.5
    }
}
window-rule {
    match app-id=r#"^obsidian$"#
    default-column-width {
        proportion 0.33333
    }
}

// comms → named workspaces, hidden from screencasts
window-rule {
    match app-id=r#"(?i)^discord"#
    match app-id=r#"^org\.telegram\.desktop$"#
    match app-id=r#"(?i)^signal"#
    open-on-workspace "chat"
    default-column-width {
        proportion 0.5
    }
    block-out-from "screencast"
}
window-rule {
    match app-id=r#"(?i)^thunderbird"#
    match app-id=r#"(?i)^slack"#
    match app-id=r#"(?i)^mattermost\.desktop"#
    open-on-workspace "work"
    default-column-width {
        proportion 0.33333
    }
    block-out-from "screencast"
}

// startup layout: browser + notes land on the web workspace (which pins
// itself to the external panel when docked)
window-rule {
    match at-startup=true app-id=r#"(?i)^(firefox|org\.mozilla\.firefox)"#
    match at-startup=true app-id=r#"^obsidian$"#
    open-on-workspace "web"
}

// Grayjay: was ws4/monocle on the laptop panel
window-rule {
    match title=r#"^Grayjay$"#
    open-maximized true
    open-on-output "eDP-1"
}

// satty annotation editor
window-rule {
    match app-id=r#"^com\.gabm\.satty$"#
    open-floating true
    default-column-width {
        proportion 0.8
    }
    default-window-height {
        proportion 0.8
    }
}

// subtle inactive dim (was opacity "1.0 0.97")
window-rule {
    match is-active=false
    opacity 0.97
}

// picture-in-picture: floating bottom-right, no focus steal, always opaque
window-rule {
    match title=r#"^Picture-in-Picture$"#
    open-floating true
    open-focused false
    default-column-width {
        fixed 300
    }
    default-window-height {
        fixed 169
    }
    default-floating-position x=20 y=20 relative-to="bottom-right"
    opacity 1.0
}

// Firefox/Thunderbird draw their own 1px dark border under niri's,
// muddying the stylix border — clip them to their geometry.
window-rule {
    match app-id=r#"(?i)^(firefox|org\.mozilla\.firefox)"#
    match app-id=r#"(?i)^thunderbird"#
    clip-to-geometry true
}

// red ring on the window currently being screencast via the dynamic
// cast target (Mod+S) — visible reminder of what the meeting sees
window-rule {
    match is-window-cast-target=true
    border {
        active-color "#d75f5f"
        inactive-color "#d75f5f"
    }
}

// ----- layer rules ----------------------------------------------------
// Client-requested blur should sample the content behind shell surfaces.
// Requires Niri 26.04; the bar exception below keeps its gaps clear.
layer-rule {
    match namespace="^noctalia-"
    background-effect {
        xray false
    }
}

layer-rule {
    match namespace="^noctalia-window-switcher$"
    background-effect {
        blur true
    }
}

// Noctalia 5.0.1 requests blur over the full bar, including transparent gaps.
// Keep the capsule islands translucent without a continuous blurred strip.
layer-rule {
    match namespace="^noctalia-bar-default$"
    background-effect {
        blur false
        xray false
    }
}

// Notifications carry message content — keep them out of screencasts,
// same as the chat/work/KeePassXC window rules.
layer-rule {
    match namespace="^noctalia-notification$"
    block-out-from "screencast"
}

// ----- switch events --------------------------------------------------
// Runs even when the session is already locked; niri powers the panel
// off/on with the lid by itself. Logind owns suspend; Noctalia also locks
// before sleep. Keep this lock for docked cases where logind ignores the lid.
switch-events {
    lid-close { spawn "noctalia" "msg" "session" "lock"; }
}

window-rule {
    match app-id=r#"^dev\.noctalia\.Noctalia$"#
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}

// Noctalia's notification actions and window switcher use XDG activation.
debug {
    honor-xdg-activation-with-invalid-serial
}
