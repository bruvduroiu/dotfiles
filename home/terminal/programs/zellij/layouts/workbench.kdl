// Per-project workbench, one full-screen tab each: the coding-agent picker
// (unnamed, titled by the agent), Helix (hx), jjui (vcs). Alt+1/2/3 jump between them. The
// `default_layout`, so every new session (`lzj NAME`, `zj NAME`, yazi `W`)
// gets it; start one from the project root, since every pane inherits the
// cwd and nothing here hardcodes a path.
//
// Command panes go through `direnv exec .` so the project's .envrc (LSPs,
// toolchains) reaches hx and the agent even though zellij execs them
// directly instead of via an interactive fish. With no .envrc, direnv exec
// is a no-op. A blocked .envrc fails the pane: `direnv allow` in a shell
// pane, then Enter in the failed pane re-runs it.
layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="compact-bar"
        }
    }

    // Deliberately unnamed tab and pane: zellij (0.45+) labels a tab that
    // still has its default name and holds one framed pane with that pane's
    // OSC 0/2 title, so the agent (Claude Code, Codex, OpenCode) titles its
    // own tab. A pane `name` would override the OSC title, and a tab `name`
    // would disable the fallback. Alt Shift t pins a name by hand; a
    // resurrected session serializes "Tab #1" literally and loses it.
    tab focus=true {
        pane command="direnv" {
            args "exec" "." "agent"
        }
    }

    tab name="hx" {
        pane name="hx" command="direnv" {
            args "exec" "." "hx"
        }
    }

    tab name="vcs" {
        pane name="jjui" command="direnv" {
            args "exec" "." "jjui"
        }
    }
}
