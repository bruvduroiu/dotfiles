# btop theme rendered by Noctalia on every theme/mode change.
#
# Split by role, the same way the jjui theme is: every *hue* comes from the
# terminal palette, so btop's graphs agree with every other TUI in the
# terminal, while every *surface* comes from Noctalia's Material roles, so
# panels and selections keep real elevation in light mode as well as dark.
#
# Gradient hues deliberately reproduce the ones Stylix used, so the meters
# read the same as before: low is green, high is red.

# Empty for terminal default — this is what keeps the 0.9 terminal opacity
# visible. `theme_background = false` in btop.conf enforces it besides.
theme[main_bg]=""
theme[main_fg]="{{colors.terminal_foreground.default.hex}}"
theme[title]="{{colors.terminal_foreground.default.hex}}"
theme[hi_fg]="{{colors.primary.default.hex}}"
theme[selected_bg]="{{colors.surface_container_high.default.hex}}"
theme[selected_fg]="{{colors.on_surface.default.hex}}"
theme[inactive_fg]="{{colors.outline.default.hex}}"
theme[graph_text]="{{colors.on_surface_variant.default.hex}}"
theme[meter_bg]="{{colors.surface_container.default.hex}}"
theme[div_line]="{{colors.outline_variant.default.hex}}"

# Four boxes, four distinct hues.
theme[proc_misc]="{{colors.terminal_normal_magenta.default.hex}}"
theme[cpu_box]="{{colors.terminal_normal_magenta.default.hex}}"
theme[mem_box]="{{colors.terminal_normal_green.default.hex}}"
theme[net_box]="{{colors.terminal_normal_cyan.default.hex}}"
theme[proc_box]="{{colors.terminal_normal_blue.default.hex}}"

# Temperature: cool -> hot.
theme[temp_start]="{{colors.terminal_normal_green.default.hex}}"
theme[temp_mid]="{{colors.terminal_normal_yellow.default.hex}}"
theme[temp_end]="{{colors.terminal_normal_red.default.hex}}"

# CPU load: idle -> saturated.
theme[cpu_start]="{{colors.terminal_normal_green.default.hex}}"
theme[cpu_mid]="{{colors.terminal_normal_yellow.default.hex}}"
theme[cpu_end]="{{colors.terminal_normal_red.default.hex}}"

# Memory segments.
theme[free_start]="{{colors.terminal_normal_yellow.default.hex}}"
theme[free_mid]="{{colors.terminal_normal_green.default.hex}}"
theme[free_end]="{{colors.terminal_normal_green.default.hex}}"
theme[cached_start]="{{colors.terminal_normal_cyan.default.hex}}"
theme[cached_mid]="{{colors.terminal_normal_cyan.default.hex}}"
theme[cached_end]="{{colors.terminal_normal_yellow.default.hex}}"
theme[available_start]="{{colors.terminal_normal_red.default.hex}}"
theme[available_mid]="{{colors.terminal_normal_yellow.default.hex}}"
theme[available_end]="{{colors.terminal_normal_green.default.hex}}"
theme[used_start]="{{colors.terminal_normal_yellow.default.hex}}"
theme[used_mid]="{{colors.terminal_bright_yellow.default.hex}}"
theme[used_end]="{{colors.terminal_normal_red.default.hex}}"

# Network and process graphs: quiet -> busy.
theme[download_start]="{{colors.terminal_normal_green.default.hex}}"
theme[download_mid]="{{colors.terminal_normal_yellow.default.hex}}"
theme[download_end]="{{colors.terminal_normal_red.default.hex}}"
theme[upload_start]="{{colors.terminal_normal_green.default.hex}}"
theme[upload_mid]="{{colors.terminal_normal_yellow.default.hex}}"
theme[upload_end]="{{colors.terminal_normal_red.default.hex}}"
theme[process_start]="{{colors.terminal_normal_green.default.hex}}"
theme[process_mid]="{{colors.terminal_normal_yellow.default.hex}}"
theme[process_end]="{{colors.terminal_normal_red.default.hex}}"
